# Copy to .env. Never commit real API keys.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model is configurable because the plan's Gemini 1.5/2.0 models are retired.
GEMINI_MODEL=gemini-3.8-flash
AI_MODE=live
AI_ALLOW_FALLBACK=true
AI_TIMEOUT_SECONDS=20
# Optional: use an installed FFmpeg executable instead of the bundled binary.
FFMPEG_BINARY=

# ==============================================================================
# AI Mock Interview Platform — Backend Environment Configuration
# ==============================================================================

# Database Configuration
# - Mặc định để trống sẽ tự động dùng SQLite: sqlite:///interview.db
# - Khi triển khai PostgreSQL (Production/Docker):
# DATABASE_URL=postgresql://interview_user:interview_pass@db:5432/interview_db
DATABASE_URL=

# AI API Keys
# Gemini Flash API (Phục vụ chấm điểm phỏng vấn và Chatbot Coach)
GEMINI_API_KEY=

# Sinh câu hỏi theo JD; độc lập với GEMINI_MODEL dùng chấm điểm
QUESTION_GENERATION_MODEL=gemini-3.5-flash-lite
QUESTION_GENERATION_TIMEOUT_SECONDS=30

# Groq Whisper API (Phục vụ bóc băng âm thanh tốc độ cao)
GROQ_API_KEY=

# OpenAI Whisper API (Tùy chọn fallback)
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ==============================================================================
# Git Ignore Rules for Crowd Emotion Recognition Project
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Model Weights & Heavy Checkpoints ---
*.pt
*.pth
*.onnx
*.bin
*.h5
*.tflite
*.engine
yolov8n.pt

# Ngoại lệ cho trọng số mô hình chính thức của dự án
!weights/crowd_emotion_resnet18.pt
!weights/yolov8n-face.pt

# --- Datasets & Media (Tránh đẩy dữ liệu ảnh lớn lên Git) ---
Dataset/
Dataset_Dummy/
Dataset_Test/
Resources/Faces/Train/
Resources/Faces/Validation/
Resources/ignored/

# --- Large Video Files (Ngoại trừ video mẫu gốc) ---
*.mp4
*.avi
*.mov
*.mkv
!Resources/Video/2021-09-22 17.32.08.mp4

# --- Training Runs & Logs ---
runs/
*.log

# --- Tài liệu nội bộ (User-specified) ---
docs/
# ==============================================================================
# Git Ignore Rules for AI Mock Interview & Emotion Recognition Platform
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
*/.venv/
backend/.venv/
training/.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Node.js & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Databases & SQLite Local Storage ---
*.db
*.sqlite
*.sqlite3
backend/interview.db

# --- Environment Variables & Secrets ---
.env
.env.local
.env.*.local
serviceAccountKey.json
*firebase*.json

# --- Model Weights & Heavy Checkpoints ---
*.pth
*.bin
*.h5
*.tflite
*.engine
yolov8n.pt

# Ngoại lệ cho trọng số mô hình chính thức của dự án
!weights/crowd_emotion_resnet18.pt
!weights/yolov8n-face.pt
!backend/weights/mini_resnet_se_6emo.onnx
!backend/weights/mini_resnet_se_6emo_quant.onnx


# --- Datasets & Media (Tránh đẩy dữ liệu ảnh/video quá lớn lên Git) ---
Dataset/
Dataset_Dummy/
Dataset_Test/
Data/
Resources/Faces/Train/
Resources/Faces/Validation/
Resources/ignored/

# --- Large Video Files (Ngoại trừ video mẫu gốc) ---
*.mp4
*.avi
*.mov
*.mkv
*.webm
!Resources/Video/2021-09-22 17.32.08.mp4

# --- Training Runs & Logs ---
runs/
*.log

# --- Tài liệu nội bộ (User-specified) ---
docs/

# Member B local tests and temporary audio outputs
.pytest_cache/
.tmp/
artifacts/
.env.*
!.env.example
!tests/fixtures/interview_answer_en.webm
!tests/fixtures/answer_vi_01.webm
!tests/fixtures/answer_vi_02.webm
!tests/fixtures/answer_vi_03.webm

AGENTS.md
project-context.md
.ai-agents/
.antigravityignore
.clineignore
plan/
tests/